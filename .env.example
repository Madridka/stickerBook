STICKER_BOOK_PORT=4041
STICKER_BOOK_HOST=::
# Админка доступна на /admin только после задания пароля (минимум 12 символов).
# STICKER_BOOK_ADMIN_USERNAME=admin
# STICKER_BOOK_ADMIN_PASSWORD=replace-with-a-long-random-password
# STICKER_BOOK_DATABASE_PATH=server/data/sticker-book.sqlite
# Автоматические online-бэкапы SQLite: при старте и далее по расписанию.
# STICKER_BOOK_BACKUP_ENABLED=true
# STICKER_BOOK_BACKUP_DIRECTORY=server/data/backups
# STICKER_BOOK_BACKUP_INTERVAL_HOURS=24
# STICKER_BOOK_BACKUP_RETENTION=14
# Включайте только при доступе к приложению через HTTPS.
# NODE_ENV=production
