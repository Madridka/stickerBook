STICKER_BOOK_PORT=4041
STICKER_BOOK_HOST=0.0.0.0
# Админка доступна на /admin только с scrypt-хэшем пароля; открытый пароль запрещён.
# STICKER_BOOK_ADMIN_USERNAME=admin
# STICKER_BOOK_ADMIN_PASSWORD_HASH=<generated-scrypt-hash>
# STICKER_BOOK_DATABASE_PATH=server/data/sticker-book.sqlite
# STICKER_BOOK_ALLOWED_ORIGINS=https://sticker-book.ru,https://www.sticker-book.ru
# STICKER_BOOK_API_DOCS_ENABLED=false
# STICKER_BOOK_LOG_LEVEL=warn
# STICKER_BOOK_TRUST_PROXY=false
# Автоматические online-бэкапы SQLite: при старте и далее по расписанию.
# STICKER_BOOK_BACKUP_ENABLED=true
# STICKER_BOOK_BACKUP_DIRECTORY=server/data/backups
# STICKER_BOOK_BACKUP_INTERVAL_HOURS=24
# STICKER_BOOK_BACKUP_RETENTION=14
# Production — безопасный режим по умолчанию; development нужно указывать явно.
NODE_ENV=production
